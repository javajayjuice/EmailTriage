{
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Next.js App",
            "program": "${workspaceFolder}/${input:entryFile}",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "port": 9229
        }
    ],
    "inputs": [
        {
            "type": "pickString",
            "id": "entryFile",
            "description": "Select the entry file for your Next.js app",
            "options": [
                "src/app/layout.tsx",
                "src/app/page.tsx"
            ]
        }
    ]
}