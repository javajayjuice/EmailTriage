    <PackageReference Include="MailKit" Version="4.11.0" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kairos.EmailTriage.Core\Kairos.EmailTriage.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Services\MLServiceProxy\" />
  </ItemGroup>
</Project>